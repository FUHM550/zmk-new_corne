#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LSHFT>, <&kp CAPS>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    volume_encoder: volume_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            // -----------------------------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |sup    |           |up  |     |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | SHFT |  A  |  S  |  D  |  F  |  G  |sdn    |     |left|enter|right|  H  |  J   |  K  |  L  |  ;  |  '   | 
            // | CTRL |  Z  |  X  |  C  |  V  |  B  |C_MUTE |          |down |     |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |                             | ENT | RSE  | ALT |
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R  &kp T                              &kp UP                &kp Y      &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LSHFT  &kp A  &kp S  &kp D     &kp F  &kp G                    &kp LEFT  &kp ENTER  &kp RIGHT  &kp H      &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z  &kp X  &kp C     &kp V  &kp B      &kp C_MUTE              &kp DOWN              &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                         &kp LGUI  &mo 1  &kp SPACE                                                &kp ENTER  &mo 2  &kp LALT
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        lower_layer {
            display-name = "NUMBER";
            // ------------------------------------------------------------------------------------------------------------
            // | TAB  | 7 | 8 | 9 | = | / |C_VOLUME_UP|           |M_UP|        | PG_UP|  UP | PG_DOWN | HOME |  \   | BKSP|
            // | SHFT | 4 | 5 | 6 | 0 | [ |C_VOLUME_DOWN|  |M_LEFT|LCLK|M_RIGHT | LEFT | DWN |  RIGHT  | END  | CAPS | DEL |
            // | CTRL | 1 | 2 | 3 | - | ] |C_MUTE|                |M_DOWN|      | PREV | P_P |  NEXT   | LCLK | MENU |  `  |
            //          | GUI | LWR | SPC |                                     | ENT | RSE | ALT |
            bindings = <
&trans  &kp N7  &kp N8  &kp N9  &kp EQUAL  &kp SLASH                                &mmv MOVE_UP                     &kp PG_UP   &kp UP    &kp PG_DN   &kp HOME   &kp NON_US_BSLH  &kp BSPC
&trans  &kp N4  &kp N5  &kp N6  &kp N0     &kp LBKT                 &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp LEFT    &kp DOWN  &kp RIGHT   &kp END    &kp CAPS         &kp DEL
&trans  &kp N1  &kp N2  &kp N3  &kp MINUS  &kp RBKT   &kp C_MUTE                    &mmv MOVE_DOWN                   &kp C_PREV  &kp C_PP  &kp C_NEXT  &mkp LCLK  &kp K_APP        &kp GRAVE
                        &trans  &trans     &trans                                                                    &trans      &trans    &trans
            >;

            sensor-bindings = <&volume_encoder>;
        };

        raise_layer {
            display-name = "FN&PTR";
            // ------------------------------------------------------------------------------------------------------------
            // |  TAB  | F9 | F10 | F11 | F12 | INS  |C_VOLUME_UP|           |M_UP|        |lck |mup |rck |sup |  | BKSPC |
            // | SHIFT | F5 | F6  | F7  | F8  | PRSC |C_VOLUME_DOWN|  |M_LEFT|LCLK|M_RIGHT |mlf |mdn |mrt |sdn |  |   '   |
            // | CTRL  | F1 | F2  | F3  | F4  |      |C_MUTE|                |M_DOWN|      |    |    |slf |srt |  |  ESC  |
            //                        |LGUI|LWE|SPACE|                                     |ENTER|RSE|RALT|
            bindings = <
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &kp INS                                  &mmv MOVE_UP                     &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &msc SCRL_UP     &none  &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &kp PSCRN                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN   &none  &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &none      &kp C_MUTE                    &mmv MOVE_DOWN                   &mkp MB3        &none           &msc SCRL_LEFT   &msc SCRL_RIGHT  &none  &trans
                         &trans   &trans   &kp SPACE                                                                 &kp RET         &trans          &trans
            >;

            sensor-bindings = <&volume_encoder>;
        };

        layer_3 {
            display-name = "VOL&RGB";
            // -----------------------------------------------------------------------------------------------------------------
            // |  TAB  | | | | | layer 4 toggle|C_VOLUME_UP|           |M_UP|            | C_VOLUME_UP  | | | BL_TOG | | BKSPC |
            // | SHIFT | | | | |               |C_VOLUME_DOWN|  |M_LEFT|LCLK|M_RIGHT     | C_VOLUME_DOWN| | |RGB_EFF | |   '   |
            // | CTRL  | | | | |               |C_MUTE|                |M_DOWN|          | C_MUTE       | | |        | |  ESC  |
            //        |LGUI|LWE|    SPACE      |                                         |ENTER|RSE|LALT|
            bindings = <
&trans  &none  &none  &none   &none   &mo 4                                 &mmv MOVE_UP                     &kp C_VOL_UP  &none   &none   &rgb_ug RGB_TOG  &none  &trans
&trans  &none  &none  &none   &none   &none                 &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp C_VOL_DN  &none   &none   &rgb_ug RGB_EFF  &none  &trans
&trans  &none  &none  &none   &none   &none   &kp C_MUTE                    &mmv MOVE_DOWN                   &kp C_MUTE    &none   &none   &none            &none  &trans
                      &trans  &trans  &trans                                                                 &trans        &trans  &trans
            >;

            sensor-bindings = <&volume_encoder>;
        };

        layer_4 {
            display-name = "BT";
            // -----------------------------------------------------------------------------------------
            // |  TAB  |  BT_NXT   |     | | | |C_VOLUME_UP|           |M_UP|        | | | | | | BKSPC |
            // | SHIFT | BT_CLR_ALL|     | | | |C_VOLUME_DOWN|  |M_LEFT|LCLK|M_RIGHT | | | | | |   '   |
            // | CTRL  | BT_OUT    | USB | | | |C_MUTE|                |M_DOWN|      | | | | | |  ESC  |
            //                  |LGUI|LWE|SPACE|                                     |ENTER|RSE|LALT|
            bindings = <
&trans  &bt BT_NXT    &none         &none   &none   &none                                 &mmv MOVE_UP                     &none   &none   &none   &none  &none  &none
&trans  &bt BT_CLR    &none         &none   &none   &none                 &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &none   &none   &none   &none  &none  &none
&trans  &out OUT_BLE  &out OUT_USB  &none   &none   &none   &kp C_MUTE                    &mmv MOVE_DOWN                   &none   &none   &none   &none  &none  &none
                                    &trans  &trans  &trans                                                                 &trans  &trans  &trans
            >;

            sensor-bindings = <&volume_encoder>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
