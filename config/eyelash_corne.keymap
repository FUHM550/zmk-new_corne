 *
 * SPDX-License-Identifier: MIT
 */

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen {
        zmk,matrix_transform = &default_transform;
    };
};

&mmv_input_listener {
    input-processors = <&zip_xy_scaler 2 1>;
};

&msc_input_listener {
    input-processors = <&zip_scroll_scaler 2 1>;
};

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <2000>;
};

/ {
    behaviors {

        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;

            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <100>;
        };

        volume_encoder: volume_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;

            bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* =================================================================================
         * BASE LAYER
         * - Joystick = Arrow keys
         * - Joystick center = Enter
         * - Encoder rotate = Scroll
         * - Encoder press = Mute
         * =================================================================================
         */

        default_layer {
            display-name = "QWERTY";

            bindings = <
&kp TAB         &kp Q  &kp W  &kp E     &kp R  &kp T                               &kp UP_ARROW                &kp Y      &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LEFT_SHIFT  &kp A  &kp S  &kp D     &kp F  &kp G                     &kp LEFT  &kp ENTER  &kp RIGHT      &kp H      &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL       &kp Z  &kp X  &kp C     &kp V  &kp B        &kp SPACE              &kp DOWN_ARROW              &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                              &kp LGUI  &mo 1  &kp SPACE                                               &kp ENTER  &mo 2  &kp LALT
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        /* =================================================================================
         * LOWER LAYER
         * - Joystick = Mouse movement
         * - Joystick center = Left click
         * - Encoder rotate = Volume
         * - Encoder press = Mute
         * =================================================================================
         */

        lower_layer {
            display-name = "NUMBER";

            bindings = <
&trans  &kp N7        &kp N8        &kp N9        &kp EQUAL  &kp SLASH                               &mmv MOVE_UP                     &kp PG_UP       &kp UP_ARROW      &kp PAGE_DOWN  &kp HOME   &kp NON_US_BACKSLASH  &kp BSPC
&trans  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp N0     &kp LEFT_BRACKET         &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp LEFT         &kp DOWN         &kp RIGHT      &kp END    &kp CAPS              &kp DEL
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp MINUS  &kp RIGHT_BRACKET                       &mmv MOVE_DOWN                   &kp C_PREVIOUS  &kp K_PLAY_PAUSE  &kp C_NEXT     &kp C_MUTE &kp K_CONTEXT_MENU    &kp GRAVE
                                    &trans        &trans     &trans                                                       &trans          &trans            &trans
            >;

            sensor-bindings = <&volume_encoder>;
        };

        /* =================================================================================
         * RAISE LAYER
         * =================================================================================
         */

        raise_layer {
            display-name = "FN&PTR";

            bindings = <
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &kp INS                               &mmv MOVE_UP                     &mkp RCLK        &msc SCRL_UP     &none  &none  &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &kp PRINTSCREEN        &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN   &none  &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &none                                  &mmv MOVE_DOWN                   &mkp MB3         &msc SCRL_LEFT   &msc SCRL_RIGHT  &none  &kp C_MUTE
                         &trans   &trans   &kp SPACE                                                     &kp RET         &trans          &kp RALT
            >;

            sensor-bindings = <&volume_encoder>;
        };

        /* =================================================================================
         * LAYER 3
         * =================================================================================
         */

        layer_3 {
            display-name = "VOL&RGB";

            bindings = <
&trans  &none     &none   &none   &none   &mo 4                                 &mmv MOVE_UP                     &none   &none   &rgb_ug RGB_TOG  &none  &trans
&trans  &none     &none   &none   &none   &none                   &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &none   &none   &rgb_ug RGB_EFF  &none  &trans
&trans  &none     &none   &none   &none   &none                                   &mmv MOVE_DOWN                   &none   &none   &none            &none  &kp C_MUTE
                          &trans  &trans  &trans                                                       &trans  &trans  &trans
            >;

            sensor-bindings = <&volume_encoder>;
        };

        /* =================================================================================
         * BLUETOOTH LAYER
         * =================================================================================
         */

        layer_4 {
            display-name = "BT";

            bindings = <
&trans  &bt BT_NXT   &none         &none   &none   &none                           &mmv MOVE_UP                     &none   &none   &none  &none  &none
&trans  &bt BT_CLR   &none         &none   &none   &none             &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &none   &none   &none  &none  &none
&trans  &out OUT_BLE &out OUT_USB  &none   &none   &none                             &mmv MOVE_DOWN                   &none   &none   &none  &none  &kp C_MUTE
                                &trans  &trans   &trans                                                   &trans  &trans  &trans
            >;

            sensor-bindings = <&volume_encoder>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
```
